import streamlit as st

st.set_page_config(
    page_title="下了吗鱼",
    page_icon="🐟",
    layout="wide",
)

st.title("🐟 下了吗鱼")
st.caption("校园里的闲置好物、生活信息，都在这里发现。")

search_text = st.text_input(
    "🔍 搜一搜",
    placeholder="试试搜索：教材、自行车、台灯……",
)

st.subheader("逛逛分类")
categories = ["全部", "教材资料", "数码产品", "生活用品", "运动户外"]
selected_category = st.radio(
    "选择分类",
    categories,
    horizontal=True,
    label_visibility="collapsed",
)

st.divider()
st.subheader("校园热门")

items = [
    {"name": "高数教材（九成新）", "category": "教材资料", "price": "¥20", "seller": "小林"},
    {"name": "宿舍台灯，可调亮度", "category": "生活用品", "price": "¥15", "seller": "阿明"},
    {"name": "闲置篮球一个", "category": "运动户外", "price": "¥35", "seller": "同学"},
    {"name": "无线鼠标，功能正常", "category": "数码产品", "price": "¥25", "seller": "小周"},
]

shown_items = [
    item for item in items
    if selected_category == "全部" or item["category"] == selected_category
]

if search_text:
    shown_items = [
        item for item in shown_items
        if search_text.lower() in item["name"].lower()
    ]

if not shown_items:
    st.info("没有找到相关商品，换个关键词或分类试试。")
else:
    columns = st.columns(2)

    for index, item in enumerate(shown_items):
        with columns[index % 2]:
            with st.container(border=True):
                st.markdown(f"### {item['name']}")
                st.write(f"分类：{item['category']}　·　发布者：{item['seller']}")
                st.markdown(f"**{item['price']}**")

st.divider()
st.caption("下了吗鱼 · 让闲置流动起来")